# ── Auth.js (server-side confidential client) ──────────────────────────────────
# Used by next-auth for session management. Never exposed to the browser.
CLAVEX_ISSUER=https://id.example.com/acme
CLAVEX_CLIENT_ID=your-confidential-client-id
CLAVEX_CLIENT_SECRET=your-confidential-client-secret

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production

# ── @clavex/react (browser public client) ──────────────────────────────────────
# Used by PasskeyEnrollment + OrganizationSwitcher widgets. No secret needed.
NEXT_PUBLIC_CLAVEX_URL=https://id.example.com/acme
NEXT_PUBLIC_CLAVEX_CLIENT_ID=your-public-pkce-client-id
